<form method="POST" action="/<%=message.id%>">
  <h1>Your message</h1>
  <div class="form-group">
    <input
      type="text"
      name="messageUser"
      value="<%=message.user %>"
      id="user"
      required
    />
  </div>
  <div class="form-group">
    <input
      type="text"
      name="messageText"
      value="<%=message.text %>"
      id="message"
      required
    />
  </div>
  <div class="form-actions">
    <button type="submit">Update Message</button>
    <a href="/" class="btn btn-cancel">Go back</a>
  </div>
</form>
